{
  "schema_version": "check-domains-1",
  "comment": "Decision 106: the domain of every acceptance check and every harness stage, the one table tools/run_paper, tools/run_papers, tools/pick_papers and tools/convq read (lib/relatex/check_domains.rb). core always runs: it reads the model and the native PDF, which every output is made from. A domain's convert flags are what the product conversion adds for it; browser: its acceptance checks need the harness's browser session. A domain without checks or stages (synctex) selects nothing beyond core in the harness today: the unit suite and its tools cover it. pdfua has no convert flags on purpose: its stage converts once more with --format pdf-ua in the run's project cache (tools/pdfua_stage.rb), beside the acceptance.",
  "domains": {
    "core": {
      "summary": "The verified model and the native PDF: inputs, preservation, the document model, text inventory, paragraphs, word boundaries, styles, math, references, structure, floats, metadata, fonts, page total.",
      "convert_flags": ["--html", "--json"],
      "browser": false,
      "stages": ["probe", "preservation", "export", "acceptance"]
    },
    "html": {
      "summary": "The page in a browser: the product's browser verification and axe-core, the acceptance's browser rendering, text paint, table rule ink, chapter files and index links.",
      "convert_flags": ["--verify-browser"],
      "pick_tex": ["\\\\begin[{](tabular|tabularx|longtable|array)[}]", "\\\\(textcolor|colorbox|color)\\b", "\\\\(makeindex|printindex)\\b", "\\\\chapter\\b"],
      "browser": true,
      "stages": ["browser"]
    },
    "epub": {
      "summary": "The EPUB 3 package judged by epubcheck and DAISY Ace; the package's accessibility claim comes from the product's browser verification, so it converts with --verify-browser too.",
      "convert_flags": ["--epub", "--verify-browser"],
      "pick_tex": ["\\\\chapter\\b", "\\\\includegraphics", "\\\\href"],
      "browser": false,
      "stages": ["epub"]
    },
    "markdown": {
      "summary": "The Markdown export: written by the conversion, which fails when it cannot be.",
      "convert_flags": ["--markdown"],
      "pick_tex": ["\\\\begin[{](align|gather|multline|array)[*]?[}]", "\\\\includegraphics"],
      "browser": false,
      "stages": []
    },
    "typst": {
      "summary": "The Typst export, judged by the Typst acceptance (decision 154; tools/typst_stage.rb): decision 063 invariants on typst-source/ (compiles, labels, references, numbers, citations, counts, text coverage, source lint), a verdict apart from the core checks.",
      "convert_flags": ["--typst"],
      "pick_tex": ["\\\\begin[{](align|gather|multline|array)[*]?[}]", "\\\\includegraphics"],
      "browser": false,
      "stages": ["typst"]
    },
    "pdfua": {
      "summary": "The tagged PDF (PDF/UA-2): the pdfua stage builds it from the run's conversion (route 2, the ordinary PDF tagged from the model) and records the product's status, veraPDF's verdict and the page counts; tools/check_verapdf and test/tagged_*_pdf_test.rb test it outside the harness.",
      "convert_flags": [],
      "browser": false,
      "stages": ["pdfua"]
    },
    "synctex": {
      "summary": "Word-level SyncTeX: no harness stage yet (test/synctex_command_test.rb, tools/check_sync_math).",
      "convert_flags": [],
      "browser": false,
      "stages": []
    }
  },
  "convert_order": ["--html", "--markdown", "--typst", "--json", "--epub", "--verify-browser"],
  "checks": {
