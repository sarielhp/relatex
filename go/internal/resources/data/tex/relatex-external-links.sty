\ProvidesPackage{relatex-external-links}[2026/10/16 Executed external hyperlink evidence]
\directlua{ltd.external_links=require('relatex-external-links');ltd.flow.external_links=ltd.external_links}
\newcommand\ltd@external@links@install{%
  \AddToHookWithArguments{cmd/hyper@linkurl/before}[relatex-external-link]{%
    \directlua{ltd.external_links.begin_link('\luaescapestring{##2}')}}%
  \AddToHook{cmd/hyper@linkurl/after}[relatex-external-link]{\directlua{ltd.external_links.end_link()}}%
  \AddToHookWithArguments{cmd/hyper@linkfile/before}[relatex-external-link]{%
    \directlua{ltd.external_links.begin_link('\luaescapestring{##2}')}}%
  \AddToHook{cmd/hyper@linkfile/after}[relatex-external-link]{\directlua{ltd.external_links.end_link()}}}
\@ifpackageloaded{hyperref}{\ltd@external@links@install}{\AddToHook{package/hyperref/after}{\ltd@external@links@install}}
\endinput
