TR: TH /O=/Table /Scope=/Column | TH /O=/Table /Scope=/Column
TR: TH /O=/Table /Scope=/Row | TD /O=/Table | TD /O=/Table | TD /O=/Table
TR: TH /O=/Table /Scope=/Row | TD /O=/Table | TD /O=/Table | TD /O=/Table
# rule_after_every_column
TR: TD /O=/Table | TD /O=/Table | TD /O=/Table
TR: TD /O=/Table | TD /O=/Table | TD /O=/Table
TR: TD /O=/Table | TD /O=/Table | TD /O=/Table
TR: TD /O=/Table | TD /O=/Table | TD /O=/Table
