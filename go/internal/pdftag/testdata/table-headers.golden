# bold_first_column
TR: TH /O=/Table /Scope=/Column | TH /O=/Table /Scope=/Column | TH /O=/Table /Scope=/Column
TR: TH /O=/Table /Scope=/Row | TD /O=/Table | TD /O=/Table
TR: TH /O=/Table /Scope=/Row | TD /O=/Table | TD /O=/Table
TR: TH /O=/Table /Scope=/Row | TD /O=/Table | TD /O=/Table
# multicolumn_groups
