\ProvidesPackage{relatex-math}[2026/10/13 v0.6.0 math retention experiment]
\ExplSyntaxOn
\cs_new_protected:Npn \__ltd_math_install: {
  \socket_if_plug_assigned:nnF {tagsupport/math/struct/begin}{mathml-AF}
    {\PackageError{relatex-math}{Unexpected~math~begin~plug}{Unsupported~adapter~configuration}}
  \socket_if_plug_assigned:nnF {tagsupport/math/struct/end}{mathml-AF}
    {\PackageError{relatex-math}{Unexpected~math~end~plug}{Unsupported~adapter~configuration}}
  \cs_new_eq:Nc \__ltd_math_begin_original: {__socket_tagsupport/math/struct/begin_plug_mathml-AF:w}
  \cs_new_eq:Nc \__ltd_math_end_original: {__socket_tagsupport/math/struct/end_plug_mathml-AF:w}
  \NewTaggingSocketPlug{math/struct/begin}{relatex}{
    \__ltd_math_begin_original:
    \directlua{ltd.math_bridge.begin_formula(\int_use:N\g__math_math_total_int,
      '\luaescapestring{\l__math_attribute_class_tl}' == 'display')}
  }
  \NewTaggingSocketPlug{math/struct/end}{relatex}{
    \directlua{ltd.math_bridge.end_formula()}
    \__ltd_math_end_original:
  }
  \AssignTaggingSocketPlug{math/struct/begin}{relatex}
  \AssignTaggingSocketPlug{math/struct/end}{relatex}
}
% The kernel executes next-invocation code after document-level setup, where
% latex-lab activates its writer and assigns the mathml-AF plugs.
\AddToHookNext{begindocument/end}{\__ltd_math_install:}
