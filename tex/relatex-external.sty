\AddToHook{env/itemize/after}{\directlua{ltd.external_lists.finish('itemize')}}
\AddToHook{env/enumerate/begin}{\directlua{ltd.external_lists.begin('enumerate',\number\@listdepth)}}
\AddToHook{env/enumerate/after}{\directlua{ltd.external_lists.finish('enumerate')}}
