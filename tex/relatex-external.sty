\AddToHook{begindocument/end}[relatex-text-style]{\ltd@observe@textstyle}
\directlua{ltd.notes = require('relatex-notes');
  ltd_external_notes = require('relatex-external-notes');ltd_external_notes.install(ltd.notes)}
\AddToHook{cmd/@footnotemark/before}{\directlua{ltd_external_notes.mark_begin('\luaescapestring{\detokenize\expandafter{\@thefnmark}}')}}
\AddToHook{cmd/@footnotemark/after}{\directlua{ltd_external_notes.mark_end()}}
% REVTeX sets the call with its own \ltx@footmark (after setting \@thefnmark), not \@footnotemark.
% With footinbib the mark is a citation of a bibliography note, not a footnote call.
\AddToHook{cmd/ltx@footmark/before}{\footinbib@sw{}{\directlua{ltd_external_notes.mark_begin('\luaescapestring{\detokenize\expandafter{\@thefnmark}}')}}}
\AddToHook{cmd/ltx@footmark/after}{\footinbib@sw{}{\directlua{ltd_external_notes.mark_end()}}}
% An after hook is appended to the definition: it is safe only when \@footnotetext
% takes its body itself (the kernel's #1). revtex's nofootinbib \@footnotetext hands
% the body to an inner macro, which would read the hook code as that body.
\ExplSyntaxOn
\str_if_eq:eeT { \cs_argument_spec:N \@footnotetext } { \c_hash_str 1 }
  {
    \AddToHook{cmd/@footnotetext/before}{\directlua{ltd_external_notes.body_begin('\luaescapestring{\detokenize\expandafter{\@thefnmark}}')}}
    \AddToHook{cmd/@footnotetext/after}{\directlua{ltd_external_notes.body_end()}}
  }
% AASTeX 5 (aastex.cls) reads the body after \@footnotetext, which takes no parameter: the
% body is \close@footnotetext's own argument (its affiliations are such notes).
\@ifclassloaded{aastex}
  {
    \str_if_eq:eeT { \cs_argument_spec:N \close@footnotetext } { \c_hash_str 1 }
      {
        \AddToHook{cmd/close@footnotetext/before}{\directlua{ltd_external_notes.body_begin('\luaescapestring{\detokenize\expandafter{\@thefnmark}}')}}
        \AddToHook{cmd/close@footnotetext/after}{\directlua{ltd_external_notes.body_end()}}
      }
  }
  {}
% hyperref keeps copies of both, taken before these hooks apply, and sets with them the notes
% of \maketitle (\thanks), \footnotetext[n], \footnotemark[n] and \footref. Their mark is passed as
% stored, unexpanded: in a title it may hold font commands that do not expand.
\AddToHook{begindocument/before}[relatex-hyperref-notes]
  {
    \cs_if_exist:NT \H@@footnotemark
      {
        \AddToHook{cmd/H@@footnotemark/before}{\directlua{ltd_external_notes.mark_begin('\luaescapestring{\detokenize\expandafter{\@thefnmark}}')}}
        \AddToHook{cmd/H@@footnotemark/after}{\directlua{ltd_external_notes.mark_end()}}
      }
    \cs_if_exist:NT \H@@footnotetext
      {
        \str_if_eq:eeT { \cs_argument_spec:N \H@@footnotetext } { \c_hash_str 1 }
          {
            \AddToHook{cmd/H@@footnotetext/before}
              {\directlua{ltd_external_notes.copy_body_begin('\luaescapestring{\detokenize\expandafter{\@thefnmark}}')}}
            \AddToHook{cmd/H@@footnotetext/after}{\directlua{ltd_external_notes.body_end()}}
          }
      }
  }
\ExplSyntaxOff
% A class that prints an author note's mark itself (JINST's \author[a,1], PoS's
% \author*[a,\dagger]) sets only its body, in \maketitle: bodies set there are title notes.
% Only a \maketitle without parameters is wrapped, so no argument is read across the wrapper.
\ExplSyntaxOn
\AddToHook{begindocument/end}[relatex-title-notes]
  {
    \token_if_macro:NT \maketitle
      {
        \str_if_eq:eeT { \cs_argument_spec:N \maketitle } { }
          {
            \cs_set_eq:NN \__ltd_maketitle: \maketitle
            \cs_set:Npn \maketitle
              {
                \directlua{ltd_external_notes.title_begin()}
                \__ltd_maketitle:
                \directlua{ltd_external_notes.title_end()}
              }
          }
      }
  }
% LaTeX can hook only a macro: a document that lets \@makefnmark to a primitive (\let\@makefnmark
% \noindent, which sets no mark) would stop at \begin{document}. Such a command typesets no mark
% to observe: its hooks are skipped and the log says so. The command is judged in the
% begindocument hook, after every package set it and before generic hooks are patched in.
\AddToHook{begindocument}[relatex-external-notes]
  {
    \token_if_macro:NTF \@makefnmark
      {
        \AddToHook{cmd/@makefnmark/before}[relatex-external]{\directlua{ltd_external_notes.number_begin()}}
        \AddToHook{cmd/@makefnmark/after}[relatex-external]{\directlua{ltd_external_notes.number_end()}}
      }
      {
        \iow_log:e
          { relatex-external:~\token_to_str:N \@makefnmark \c_space_tl is~not~a~macro;~its~mark~hooks~are~skipped }
      }
  }
\ExplSyntaxOff
\directlua{ltd_external_math = require('relatex-external-math');ltd_external_math.install(ltd)}
% listings sets a listing in a table cell (inner horizontal mode) as $\vcenter{...}$ (or \vtop,
% \vbox by boxpos): that formula is layout, and the listing's lines stay code text.
% A display listing (lstlisting, \lstinputlisting) not set in a box is a code block (decision 120):
% its lines are one code context, from listings' PreInit (after the listing's top caption) to DeInit.
% PreInit, not Init: the Init hooks build the frame and background box (\lst@framebox) that every
% line copies, and a box built outside the code context would set the wrapped lines' background in
% the enclosing float's paragraph, between the listing's lines (papers 14, papers4 1024).
\@ifpackageloaded{listings}{%
  \lst@AddToHook{BoxUnsafe}{\directlua{ltd_external_math.listing_box()}}%
  \lst@AddToHook{PreInit}{\lst@ifbox\else\lst@ifdisplaystyle\directlua{ltd.listing_begin()}\fi\fi}%
  \lst@AddToHook{DeInit}{\directlua{ltd.listing_end()}}}{}
