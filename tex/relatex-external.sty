\RequirePackage{etoolbox}
\AddToHookWithArguments{cmd/HyRef@autosetref/before}[relatex-external-autoref]{%
  \directlua{ltd.flow.autoref_label('\luaescapestring{#2}')}}
\def\ltd@autoref@begin{\directlua{ltd.flow.autoref_begin()}}
\def\ltd@autoref@end{\directlua{ltd.flow.reference_end()}}
\AddToHook{begindocument/end}[relatex-external-autoref]{%
