\AddToHook{cmd/check@mathfonts/after}[relatex-math-remap]{\directlua{require('relatex-math-remap').install_once()}}
% Read the actual NFSS family assignment when TeX initializes math fonts. This
% observes declared encodings rather than inferring them from font names.
\AddToHookWithArguments{cmd/getanddefine@fonts/before}[relatex-external-math]{%
  \directlua{ltd_external_math.family(\number#1,'\luaescapestring{\string#2}')}}
\AddToHookWithArguments{cmd/getanddefine@fonts/after}[relatex-external-alphabets]{%
  \directlua{ltd_external_math.bind_fonts('\luaescapestring{\string#2}',
    \fontid\textfont@name,\fontid\scriptfont@name,\fontid\font@name)}}
\AddToHookWithArguments{cmd/@setref/before}[relatex-external-reference]{%
  \directlua{ltd.flow.reference_begin('\luaescapestring{#3}', '\luaescapestring{\string#2}')}}
\AddToHook{cmd/@setref/after}[relatex-external-reference]{\directlua{ltd.flow.reference_end()}}
% cleveref prints \cref, \Cref and \crefrange itself: each label of the call names its own link,
% in order, and the link's text ("fig. 3") is that label's use. The label queue is filled where
% the call names its labels and drained by the links the formats open.
\AddToHookWithArguments{cmd/@@@setcref/before}[relatex-external-reference]{%
  \directlua{ltd.flow.cref_labels('\luaescapestring{#2}')}}
\AddToHookWithArguments{cmd/@@@setcrefrange/before}[relatex-external-reference]{%
  \directlua{ltd.flow.cref_labels('\luaescapestring{#2}', '\luaescapestring{#3}')}}
