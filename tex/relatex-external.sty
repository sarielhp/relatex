% No DocumentMetadata, latex-lab, tagpdf, layout repair or PDF literals.
% Reuse the execution/context hooks and scalar node observer independently of
% the historical native-tagging bridge. Evidence is not full-paper acceptance.
% A \documentstyle paper runs in LaTeX 2.09 compatibility mode, which rejects LaTeX2e commands
% (\newcommand with an optional argument, as etoolbox defines) in packages loaded after the class.
% The collector is a LaTeX2e package: the check is off while it loads and on again after.
\let\ltd@latexe@error\@latex@e@error
\let\@latex@e@error\@gobble
