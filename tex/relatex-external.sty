% hyperref's \hyperref[label]{text} prints the author's own text ("Lemma 2.1" from a \ref* inside it):
% the whole text is the use of the label, and the reader checks that it ends with the number.
% \autopageref is \hyperref[label]{\pageautorefname~\pageref*{label}} ("page 7"): its use is
% recorded with the selector \autopageref, and the reader checks that it ends with the page.
\def\ltd@hyperref@selector{\string\hyperref}
\AddToHook{begindocument/end}[relatex-external-hyperref]{%
  \@ifundefined{label@hyperref}{}{%
    \let\ltd@label@hyperref\label@hyperref
    \def\label@hyperref[#1]#2{%
      \directlua{ltd.flow.reference_begin('\luaescapestring{#1}', '\luaescapestring{\ltd@hyperref@selector}')}%
      \ltd@label@hyperref[{#1}]{#2}%
      \directlua{ltd.flow.reference_end()}}}%
  \@ifundefined{HyRef@autopageref}{}{%
    \let\ltd@HyRef@autopageref\HyRef@autopageref
    \def\HyRef@autopageref#1{%
      \def\ltd@hyperref@selector{\string\autopageref}%
      \ltd@HyRef@autopageref{#1}%
      \def\ltd@hyperref@selector{\string\hyperref}}}}
% Text-mode \underline{X} is X in an \hbox over an \hrule (the kernel's \underline@text since
% LaTeX 2025-11): X reads as underlined text and the rule as its decoration (relatex-flow,
% text_underline). The wrapper only sets attributes; the box and the PDF are the kernel's.
\AddToHook{begindocument/end}[relatex-external-underline]{%
  \@ifundefined{underline@text}{}{%
    \let\ltd@underline@text\underline@text
    \protected\def\underline@text#1{%
      \leavevmode
      \begingroup
        \directlua{ltd.flow.text_underline(2)}%
        \ltd@underline@text{\directlua{ltd.flow.text_underline(1)}#1}%
        \directlua{ltd.flow.text_underline_end()}%
      \endgroup}}}
% soul's \ul and \st (decision 134, extended by the author 2026-11-12): the words of \ul read as
% underlined text (relatex.decoration 1), the words of \st as struck-out text (3). soul selects its
% preamble in a setup macro (\SOUL@stsetup runs \SOUL@ulsetup first, \SOUL@hlsetup runs
% \SOUL@stsetup first); the wrapper extends the preamble each setup leaves, which soul runs inside its
% own group, so the mark ends with the command. \hl replaces the preamble last and stays unmarked
% (a highlight, no decoration). Only attributes are set: boxes, leaders and the PDF are soul's.
\AddToHook{begindocument/end}[relatex-external-soul]{%
  \@ifundefined{SOUL@ulsetup}{}{%
    \def\ltd@soul@decoration#1{%
      \let\ltd@soul@preamble\SOUL@preamble
      \def\SOUL@preamble{\ltd@soul@preamble\directlua{ltd.flow.text_underline(#1)}}}%
    \let\ltd@SOUL@ulsetup\SOUL@ulsetup
    \def\SOUL@ulsetup{\ltd@SOUL@ulsetup\ltd@soul@decoration{1}}%
    \@ifundefined{SOUL@stsetup}{}{%
      \let\ltd@SOUL@stsetup\SOUL@stsetup
      \def\SOUL@stsetup{\ltd@SOUL@stsetup\ltd@soul@decoration{3}}}}}
