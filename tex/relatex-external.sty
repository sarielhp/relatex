% The kernel eqnarray has rows to bind as the AMS alignments do.
\directlua{ltd.external_equations = require('relatex-external-equations');ltd.external_equations.install(ltd)}%
\@for\ltd@env:=eqnarray,eqnarray*\do{%
  \expanded{\noexpand\AddToHook{env/\ltd@env/begin}{%
    \noexpand\directlua{ltd.equation_begin('\ltd@env');ltd.external_equations.begin('\ltd@env')}}}%
  \expanded{\noexpand\AddToHook{env/\ltd@env/after}{%
    \noexpand\directlua{ltd.external_equations.finish();ltd.equation_end()}}}}}{}
% Kernel \newtheorem (no amsthm) dispatches through \@thm{counter}{title}; observe it
% as amsthm's \@thm is observed. cleveref's argument-free dispatcher fails the signature.
% The title is purified first: a name set in a font switch ({\bf Proposition}) would expand the
% switch inside \directlua and stop the paper (cohort 2: 477, 511).
\ExplSyntaxOn
\cs_if_exist:NF \thm@style
  {
    \str_if_eq:eeT { \cs_argument_spec:N \@thm } { \c_hash_str 1 \c_hash_str 2 }
      {
        \AddToHookWithArguments{cmd/@thm/before}[relatex-external-theorems]
          {
            \exp_args:Nee \__ltd_theorem_begin:nn {kernel} {\@currenvir}
            \directlua{ltd.theorem_context('\luaescapestring{\@currenvir}',
              '\luaescapestring{#1}', '\luaescapestring{\text_purify:n {#2}}')}
          }
      }
  }
% ntheorem's \@thm takes #1#2#3 (environment, counter, title) as amsthm's does, but ntheorem has
% no \thm@style, so neither hook above observes it (book 0003: references to its theorems found
% no theorem context). Its environments end with their \begin group as amsthm's do. cleveref
% keeps the original as \cref@thmnoarg.
\cs_new_protected:Npn \__ltd_ntheorem_hook:n #1
  {
    \AddToHookWithArguments{cmd/#1/before}[relatex-external-theorems]
      {
        \exp_args:Nee \__ltd_theorem_begin:nn {amsthm} {\@currenvir}
        \directlua{ltd.theorem_context('\luaescapestring{\@currenvir}',
          '\luaescapestring{##2}', '\luaescapestring{\text_purify:n {##3}}')}
      }
  }
\cs_new:Npn \__ltd_ntheorem_signature:n #1
  {
    \bool_lazy_and_p:nn { \cs_if_exist_p:c {#1} }
      { \str_if_eq_p:ee { \exp_args:Nc \cs_argument_spec:N {#1} } { \c_hash_str 1 \c_hash_str 2 \c_hash_str 3 } }
  }
\@ifpackageloaded{ntheorem}
  {
    \cs_if_exist:NF \thm@style
      {
        \bool_if:nTF { \__ltd_ntheorem_signature:n {@thm} }
          { \__ltd_ntheorem_hook:n {@thm} }
          { \bool_if:nT { \__ltd_ntheorem_signature:n {cref@thmnoarg} } { \__ltd_ntheorem_hook:n {cref@thmnoarg} } }
      }
  }
  {}
\ExplSyntaxOff
