\AddToHook{env/description/after}{\directlua{ltd.external_lists.finish('description')}}
% A list environment under another name (decision 046, amendment 1): its base kind is recorded
% at each declaration (a later \renewlist may change it), its lifetime hooks are added once.
\def\ltd@observe@list#1#2#3{%
  \directlua{ltd.external_lists.alias('\luaescapestring{#1}','\luaescapestring{#2}'%
    \if\relax\detokenize{#3}\relax\else,'\luaescapestring{#3}'\fi)}%
  \ifcsname ltd@list@observed@#1\endcsname\else
    \expandafter\let\csname ltd@list@observed@#1\endcsname\@empty
    \AddToHook{env/#1/begin}[relatex-external-list]%
      {\directlua{ltd.external_lists.begin('\luaescapestring{#1}',\number\@listdepth)}}%
    \AddToHook{env/#1/after}[relatex-external-list]%
      {\directlua{ltd.external_lists.finish('\luaescapestring{#1}')}}%
  \fi}
% paralist's compact lists are the standard ones with less space, numbered by enumi..enumiv;
% its run-in lists (asparaenum, inparaenum) stay paragraph text.
\@ifpackageloaded{paralist}{%
  \ltd@observe@list{compactenum}{enumerate}{enum}%
  \ltd@observe@list{compactitem}{itemize}{}%
  \ltd@observe@list{compactdesc}{description}{}}{}
% enumitem's \newlist{NAME}{TYPE}{DEPTH} and \renewlist (an inline TYPE ends with *), declared in
% the preamble and kept by relatex-preamble.lua in order; a later one is observed at once.
\directlua{
  for _, list in ipairs(ltd_preamble and ltd_preamble.lists or {}) do
    tex.sprint(luatexbase.registernumber('catcodetable@atletter'),
      '\string\\ltd@observe@list{' .. list.name .. '}{' .. list.base .. '}{}')
  end}
\def\ltd@declare@list#1#2{\ltd@observe@list{#1}{#2}{}}
\AddToHook{cmd/@item/before}{%
  % An item without text leaves its label pending: \@item sets it in a paragraph of its own
  % when the next item comes. Set it now, before the next item's context opens.
  \if@noparitem\else\if@inlabel\indent\par\fi\fi
  \directlua{ltd.external_lists.item('\luaescapestring{\@currenvir}',\number\@listdepth)}}
\directlua{ltd.text_styles = require('relatex-text-styles');ltd.flow.text_styles = ltd.text_styles}
\newcommand\ltd@observe@textstyle{%
  \directlua{ltd.text_styles.observe('\luaescapestring{\f@encoding}',
    '\luaescapestring{\f@family}', '\luaescapestring{\f@series}', '\luaescapestring{\f@shape}',
    '\luaescapestring{\rmdefault}', '\luaescapestring{\sfdefault}', '\luaescapestring{\ttdefault}')}}
\AddToHook{cmd/selectfont/after}[relatex-text-style]{\ltd@observe@textstyle}
\AddToHook{cmd/@use@text@encoding/after}[relatex-text-style]{\ltd@observe@textstyle}
