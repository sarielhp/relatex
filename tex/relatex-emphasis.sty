\ProvidesPackage{relatex-emphasis}[2026/10/15 Guarded native emphasis punctuation]
% Native cmd/emph/after hides the caller's punctuation from the ordinary
% after-group italic-correction lookahead. Preserve both native tagging hooks,
% but defer their known trailing call until that lookahead has seen the caller.
% The hook manager uses letter tokens for cmd/ and string tokens for its suffix.
\def\ltd@emph@build#1#2{%
  \long\def\ltd@emph@expected##1{%
    \UseHookWithArguments{#1}{1}{##1}%
    \ifmmode\nfss@text{\em##1}%
    \else\hmode@bgroup\text@command{##1}\em\check@icl##1\check@icr
      \expandafter\egroup\fi
    \UseHookWithArguments{#2}{1}{##1}}}
\edef\ltd@emph@buildcall{\noexpand\ltd@emph@build
  {cmd/\detokenize{emph/before}}{cmd/\detokenize{emph/after}}}
\ltd@emph@buildcall
\def\ltd@emph@expectedcheck{\ifvmode\else\aftergroup\maybe@ic\fi}
\def\ltd@emph@expectedlook{\futurelet\@let@token\maybe@ic@}
\def\ltd@emph@check{%
  \ifx\check@icr\ltd@emph@expectedcheck
    \ifvmode\else\aftergroup\ltd@emph@look\fi
  \else\check@icr\fi}
\long\def\ltd@emph@look\UseHookWithArguments#1#2#3{%
  \def\ltd@emph@pending{\UseHookWithArguments{#1}{#2}{#3}}%
  \futurelet\@let@token\ltd@emph@finish}
\def\ltd@emph@finish{\maybe@ic@\ltd@emph@pending}
\long\def\ltd@emph@fixed#1{%
  \UseHookWithArguments{cmd/emph/before}{1}{#1}%
  \ifmmode\nfss@text{\em#1}%
  \else\hmode@bgroup\text@command{#1}\em\check@icl#1\ltd@emph@check
    \expandafter\egroup\fi
  \UseHookWithArguments{cmd/emph/after}{1}{#1}}
\AddToHook{begindocument/end}[relatex-emphasis]{%
  \ifx\maybe@ic\ltd@emph@expectedlook
    \expandafter\ifx\csname emph \endcsname\ltd@emph@expected
      \expandafter\let\csname emph \endcsname\ltd@emph@fixed
    \fi
  \fi}
\endinput
